# ==============================================================================
# Unity .gitignore
# Optimizado para Unity 6+, Netcode for GameObjects, Visual Studio / Rider / VS Code
# ==============================================================================

# ─── Carpetas Generadas por Unity ─────────────────────────────────────────────
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
ExportedObj/
sysinfo.txt
*.stackdump

# ─── Multiplayer Play Mode (Clones Virtuales) ─────────────────────────────────
.virtualprojects/
[Vv]irtual[Pp]rojects/
ProjectSettings/VirtualProjectsConfig.json

# ─── Herramientas de Asset Store y Plugins ────────────────────────────────────
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/Plugins/Editor/JetBrains*

# ─── Addressables y StreamingAssets generados ─────────────────────────────────
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ─── Archivos de Solución y Proyecto (Visual Studio / Rider / VS Code) ────────
*.sln
*.slnx
*.csproj
*.unityproj
*.booproj
*.suo
*.user
*.userprefs
*.userosscache
*.sln.docstates
.vs/
.idea/
.vscode/
.consulo/
.gradle/
*.sublime-project
*.sublime-workspace

# ─── Binarios, Ejecutables y Paquetes de Build ────────────────────────────────
*.apk
*.aab
*.app
*.exe
*.x86
*.x86_64
*.unitypackage
*.dylib
*.dll.mdb
crashlytics-build.properties

# ─── Archivos Temporales y Símbolos de Depuración ─────────────────────────────
*.tmp
*.pidb
*.pidb.meta
*.pdb
*.pdb.meta
*.mdb
*.mdb.meta
*.opendb
*.VC.db

# ─── Archivos del Sistema Operativo ───────────────────────────────────────────
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ─── Node / npm / Python (Herramientas auxiliares) ─────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/

# ─── Backups y Logs ───────────────────────────────────────────────────────────
*.bak
*.orig
*.log
*.swp

# ─── Regla de Seguridad para Metadatos de Assets ──────────────────────────────
# Garantiza que los archivos .meta de Assets nunca sean ignorados por error
!/[Aa]ssets/**/*.meta
